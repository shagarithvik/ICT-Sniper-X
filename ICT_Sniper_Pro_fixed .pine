//@version=6
strategy("ICT Sniper Pro", overlay=true, initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=0, max_bars_back=500, max_boxes_count=200, max_lines_count=200, max_labels_count=200, margin_long=1, margin_short=1)

// ══ INPUTS ══════════════════════════════════════════════
var g1 = "Risico"
riskXau = input.float(10.0, "Risico XAUUSD EUR", group=g1, minval=1)
riskBtc = input.float(20.0, "Risico BTCUSD EUR", group=g1, minval=1)
minRR   = input.float(2.0,  "Min RR",            group=g1, minval=1,   step=0.5)
maxRR   = input.float(5.0,  "Max RR",            group=g1, minval=2,   step=0.5)
multP   = input.float(2.0,  "Perfecte setup x",  group=g1, minval=1,   step=0.5)
useBE   = input.bool(true,  "Breakeven na 1R",   group=g1)
maxQty  = input.float(0.0,  "Maximale positieomvang (0 = geen limiet)", group=g1, minval=0)

var g1b = "Uitvoering"
allowLong  = input.bool(true,  "Long setups toestaan",  group=g1b)
allowShort = input.bool(true,  "Short setups toestaan", group=g1b)
useSession = input.bool(false, "Alleen binnen sessie",   group=g1b)
tradeSess  = input.session("0000-2359", "Handelssessie", group=g1b)
useTrail   = input.bool(false, "Trailing stop na 1R",    group=g1b)
trailR     = input.float(1.0, "Trailing afstand x R",    group=g1b, minval=0.1, step=0.1)

var g2 = "Filters"
swLen   = input.int(5,    "Swing lengte",           group=g2, minval=2)
swWin   = input.int(8,    "Sweep venster bars",     group=g2, minval=3)
minStp  = input.float(0.3,"Min stop x ATR",         group=g2, minval=0.1, step=0.1)
maxStp  = input.float(2.0,"Max stop x ATR",         group=g2, minval=0.5, step=0.5)
buf     = input.float(0.1,"Stop buffer x ATR",      group=g2, minval=0,   step=0.05)
disp    = input.float(0.8,"Min displacement x ATR", group=g2, minval=0.2, step=0.1)
dispMid = input.bool(true,"Displacement ook op middelste FVG-candle", group=g2)
minSc   = input.int(3,    "Min score (max 12)",     group=g2, minval=3,   maxval=12)
perfSc  = input.int(5,    "Perfecte score",         group=g2, minval=5,   maxval=12)
maxDay  = input.int(1,    "Max trades per dag",     group=g2, minval=1)
maxLoss = input.int(2,    "Stop na x verliezen",    group=g2, minval=1)
cool    = input.int(10,   "Pauze bars na verlies",  group=g2, minval=0)
fvgExp  = input.int(6,    "Limit vervalt na bars",  group=g2, minval=2)
fvgAge  = input.int(20,   "FVG max leeftijd bars",  group=g2, minval=5)

var g3 = "Spikes"
spkMul  = input.float(2.5,"Spike min x ATR",       group=g3, minval=1,   step=0.5)
spkStp  = input.float(1.5,"Spike max stop x ATR",  group=g3, minval=0.5, step=0.25)

var g4 = "VuManChu"
vmcPer  = input.int(20,   "VMC periode",           group=g4, minval=1)
vmcMul  = input.float(3.0,"VMC multiplier",        group=g4, minval=0.1, step=0.1)
showVMC = input.bool(true,"VMC tonen",             group=g4)

var g5 = "Gamma"
gamLen  = input.int(14,   "Gamma periode",         group=g5, minval=3)

var g6 = "Weergave"
showV   = input.bool(true,"Zones tonen",           group=g6)
showTbl = input.bool(true,"Tabellen tonen",        group=g6)
cBull   = input.color(#26a69a, "Kleur bull",       group=g6)
cBear   = input.color(#ef5350, "Kleur bear",       group=g6)

var g7 = "Dag High/Low Zones"
showDHL  = input.bool(true,  "Dag H/L zones tonen",        group=g7)
dhlBuf   = input.float(0.5,  "Zone breedte x ATR",         group=g7, minval=0.1, step=0.1)
dhlBias  = input.float(0.25, "Bias offset boven/onder PDH/PDL x ATR", group=g7, minval=0.0, step=0.05)

var g8 = "Debug"
debugMode = input.bool(false, "Debug Mode", group=g8)

// ══ BASIS ════════════════════════════════════════════════
atr    = ta.atr(14)
volAvg = ta.sma(volume, 20)
volOk  = volume > volAvg * 1.2
rsi    = ta.rsi(close, 14)
[_, _, macdH] = ta.macd(close, 12, 26, 9)
ema21  = ta.ema(close, 21)
ema50  = ta.ema(close, 50)
ema200 = ta.ema(close, 200)
// VWAP wordt nu elke dag gereset (was: nooit gereset = cumulatief over hele historie)
[vwap, vwapU1, vwapL1] = ta.vwap(hlc3, timeframe.change("D"), 1)
[_,    vwapU2, vwapL2] = ta.vwap(hlc3, timeframe.change("D"), 2)

isXau = str.contains(syminfo.ticker, "XAU") or str.contains(syminfo.ticker, "GOLD")
isBtc = str.contains(syminfo.ticker, "BTC")
symOk = isXau or isBtc
riskE = isBtc ? riskBtc : riskXau
inSession = not useSession or not na(time(timeframe.period, tradeSess))

// ══ HTF DATA: ALLES lookahead_off + "laatste afgesloten bar vasthouden" ══
// Patroon: haal de HTF-waarde op met lookahead_off, en neem pas op de EERSTE chart-bar van
// een nieuwe HTF-bar de waarde [1] (= laatste bar van de vorige HTF-periode = definitief).
// Zo is historie == realtime (geen repaint, geen future leak).
newH4 = timeframe.change("240")
newD  = timeframe.change("D")
tfOk  = timeframe.in_seconds() <= 14400
dataReady = not na(atr) and not na(h4Hi100) and not na(h4Lo100) and not na(h4EQ)

// EURUSD (voor risico-omrekening)
r_fx = request.security("FX:EURUSD", "D", close, lookahead=barmerge.lookahead_off)
var float fx = 1.0
if newD and not na(r_fx[1])
    fx := r_fx[1]

// Daily: vorige dag high/low + vorige dag ATR(5)
[r_pdh, r_pdl, r_datr] = request.security(syminfo.tickerid, "D", [high, low, ta.atr(5)], lookahead=barmerge.lookahead_off)
var float h4PDH = na
var float h4PDL = na
var float dAtr  = na
if newD
    h4PDH := r_pdh[1]
    h4PDL := r_pdl[1]
    dAtr  := r_datr[1]

// 4H: OHLC, pivots, 100-bar range, laatste bearish/bullish candle (voor Order Block)
[r_hi, r_lo, r_cl, r_op, r_pH, r_pL, r_hi100, r_lo100, r_bsDn, r_dnHi, r_dnLo, r_bsUp, r_upHi, r_upLo] = request.security(syminfo.tickerid, "240", [high, low, close, open, ta.pivothigh(high, swLen, swLen), ta.pivotlow(low, swLen, swLen), ta.highest(high, 100), ta.lowest(low, 100), ta.barssince(close < open), ta.valuewhen(close < open, high, 0), ta.valuewhen(close < open, low, 0), ta.barssince(close > open), ta.valuewhen(close > open, high, 0), ta.valuewhen(close > open, low, 0)], lookahead=barmerge.lookahead_off)

var float h4Hi    = na
var float h4Lo    = na
var float h4Cl    = na
var float h4Op    = na
var float h4Hi100 = na
var float h4Lo100 = na
var float h4bsDn  = na
var float h4dnHi  = na
var float h4dnLo  = na
var float h4bsUp  = na
var float h4upHi  = na
var float h4upLo  = na
if newH4
    h4Hi    := r_hi[1]
    h4Lo    := r_lo[1]
    h4Cl    := r_cl[1]
    h4Op    := r_op[1]
    h4Hi100 := r_hi100[1]
    h4Lo100 := r_lo100[1]
    h4bsDn  := r_bsDn[1]
    h4dnHi  := r_dnHi[1]
    h4dnLo  := r_dnLo[1]
    h4bsUp  := r_bsUp[1]
    h4upHi  := r_upHi[1]
    h4upLo  := r_upLo[1]

// Pivots zijn EVENTS: alleen op de eerste chart-bar na het sluiten van de 4H-bar
h4pH = newH4 ? r_pH[1] : na
h4pL = newH4 ? r_pL[1] : na
h4EQ = (h4Hi100 + h4Lo100) / 2.0

calcQ(dist, mult) =>
    mc  = math.max(syminfo.mincontract, 0.00000001)
    raw = (riskE * mult * fx) / math.max(dist * syminfo.pointvalue, 0.000001)
    q   = math.floor(raw / mc) * mc
    capped = maxQty > 0 ? math.min(q, math.floor(maxQty / mc) * mc) : q
    capped >= mc ? capped : 0.0

// ══ VUMANCHU SWING ═══════════════════════════════════════
vmcRange = ta.ema(math.abs(close - ta.ema(close, vmcPer)), vmcPer) * vmcMul
var float vmcFil = na
vmcPrev  = nz(vmcFil, close)
vmcFil  := close > vmcPrev + vmcRange ? close - vmcRange : close < vmcPrev - vmcRange ? close + vmcRange : vmcPrev
vmcUp    = close > vmcFil
vmcDn    = close < vmcFil
vmcBuy   = ta.crossover(close, vmcFil)
vmcSell  = ta.crossunder(close, vmcFil)
wtEsa    = ta.ema(hlc3, 10)
wtD      = ta.ema(math.abs(hlc3 - wtEsa), 10)
wtCi     = (hlc3 - wtEsa) / (0.015 * math.max(wtD, 0.000001))
wtWt1    = ta.ema(wtCi, 21)
wtWt2    = ta.sma(wtWt1, 4)
vmcLong  = vmcBuy  and wtWt1 < 0 and wtWt1 > wtWt2
vmcShort = vmcSell and wtWt1 > 0 and wtWt1 < wtWt2
vmcGold  = wtWt2 - wtWt1 > 0 and wtWt1 < -60

plot(showVMC ? vmcFil : na, "VMC", color=vmcUp ? color.new(cBull, 0) : color.new(cBear, 0), linewidth=2)
plotshape(showVMC and vmcLong,  "VMC Buy",  shape.triangleup,   location.belowbar, color.new(color.lime,   0), size=size.small)
plotshape(showVMC and vmcShort, "VMC Sell", shape.triangledown, location.abovebar, color.new(color.red,    0), size=size.small)
plotshape(showVMC and vmcGold,  "VMC Gold", shape.circle,       location.belowbar, color.new(color.yellow, 0), size=size.small)

// ══ GAMMA TRENDFILTER ════════════════════════════════════
gamEma1 = ta.ema(close, gamLen)
gamEma2 = ta.ema(gamEma1, gamLen)
gamRaw  = gamEma1 - gamEma2
gamPos  = gamRaw > 0 and gamRaw > gamRaw[1]
gamNeg  = gamRaw < 0 and gamRaw < gamRaw[1]
gamStr  = math.abs(gamRaw) > math.abs(gamRaw[1]) * 1.1

// ══ 4H CONTEXT (event-gedreven, alleen op nieuwe 4H-bar) ═══
var float h4SH  = na
var float h4SL  = na
var int   h4Tr  = 0
var bool  h4ShB = false
var bool  h4SlB = false
var float h4OBt = na
var float h4OBb = na
var int   h4OBd = 0

if not na(h4pH)
    h4SH  := h4pH
    h4ShB := false
if not na(h4pL)
    h4SL  := h4pL
    h4SlB := false

h4Up = newH4 and not na(h4SH) and not h4ShB and h4Cl > h4SH
h4Dn = newH4 and not na(h4SL) and not h4SlB and h4Cl < h4SL

if h4Up
    h4Tr  := 1
    h4ShB := true
    h4OBt := h4bsDn <= 10 ? h4dnHi : na
    h4OBb := h4bsDn <= 10 ? h4dnLo : na
    h4OBd := 1

if h4Dn
    h4Tr  := -1
    h4SlB := true
    h4OBt := h4bsUp <= 10 ? h4upHi : na
    h4OBb := h4bsUp <= 10 ? h4upLo : na
    h4OBd := -1

h4SSL = newH4 and not na(h4SL) and h4Lo < h4SL and h4Cl > h4SL
h4BSL = newH4 and not na(h4SH) and h4Hi > h4SH and h4Cl < h4SH

var int  h4SwLI = na
var int  h4SwHI = na
var bool h4SwLP = false
var bool h4SwHP = false

if h4SSL
    h4SwLI := bar_index
    h4SwLP := not na(h4PDL) and h4Lo < h4PDL
if h4BSL
    h4SwHI := bar_index
    h4SwHP := not na(h4PDH) and h4Hi > h4PDH

h4BsOn = not na(h4SwLI) and bar_index - h4SwLI <= swWin * 12
h4SsOn = not na(h4SwHI) and bar_index - h4SwHI <= swWin * 12
h4Bull = h4Tr == 1
h4Bear = h4Tr == -1
h4OBbl = not na(h4OBt) and h4OBd == 1  and close >= h4OBb and close <= h4OBt
h4OBbr = not na(h4OBt) and h4OBd == -1 and close >= h4OBb and close <= h4OBt

h4FR  = h4Hi100 - h4Lo100
h4GPt = h4Hi100 - h4FR * 0.618
h4GPb = h4Hi100 - h4FR * 0.786
inGP  = close >= h4GPb and close <= h4GPt

// ══ DAG TELLERS + DEBUG TELLERS ═══════════════════════════
var int trDay   = 0
var int lossDay = 0
var int lastLos = na
if ta.change(time("D")) != 0
    trDay   := 0
    lossDay := 0

var int cCtx   = 0   // canTrade + 4H trend + sweep
var int cSig   = 0   // + FVG/IFVG
var int cDisp  = 0   // + displacement
var int cRR    = 0   // + RR ok
var int cDisc  = 0   // + premium/discount ok
var int cStop  = 0   // + stop binnen min/max ATR
var int cScore = 0   // + score >= minSc
var int cOrd   = 0   // order geplaatst
var int cQ0    = 0   // qty te klein (0) -> geen order
var int cExp   = 0   // order verlopen/niet gevuld
var int cSpk   = 0   // spike-setups

// ══ LOKALE STRUCTUUR + SWEEPS ════════════════════════════
ph = ta.pivothigh(high, swLen, swLen)
pl = ta.pivotlow(low,  swLen, swLen)

var float shP = na
var int   shI = na
var float slP = na
var int   slI = na
var bool  shB = false
var bool  slB = false
var int   lTr = 0

if not na(ph)
    shP := ph
    shI := bar_index - swLen
    shB := false
if not na(pl)
    slP := pl
    slI := bar_index - swLen
    slB := false

prevTr = lTr
lUp = not na(shP) and not shB and close > shP
lDn = not na(slP) and not slB and close < slP

if lUp
    lTr := 1
    shB := true
if lDn
    lTr := -1
    slB := true

var float swLow  = na
var int   swLowI = na
var bool  swLPD  = false
var float swHi   = na
var int   swHiI  = na
var bool  swHPD  = false

sslSw = not na(slP) and low  < slP and close > slP
bslSw = not na(shP) and high > shP and close < shP
sslLvl = slP
bslLvl = shP

if sslSw
    swLow  := low
    swLowI := bar_index
    swLPD  := h4SwLP
    slP    := na
if bslSw
    swHi  := high
    swHiI := bar_index
    swHPD := h4SwHP
    shP   := na

if not na(swLowI) and bar_index - swLowI <= swWin
    swLow := math.min(swLow, low)
if not na(swHiI) and bar_index - swHiI <= swWin
    swHi  := math.max(swHi, high)

bsOn = not na(swLowI) and bar_index - swLowI <= swWin
ssOn = not na(swHiI)  and bar_index - swHiI  <= swWin

// ══ FVG + IFVG ═══════════════════════════════════════════
bFVG = low > high[2] and (low - high[2]) >= atr * 0.1
sFVG = high < low[2] and (low[2] - high) >= atr * 0.1

var bfT = array.new<float>()
var bfB = array.new<float>()
var bfI = array.new<int>()
var bfX = array.new<box>()
var sfT = array.new<float>()
var sfB = array.new<float>()
var sfI = array.new<int>()
var sfX = array.new<box>()

sBF = showV and bFVG and bsOn and h4Bull and close < h4EQ and volOk
sSF = showV and sFVG and ssOn and h4Bear and close > h4EQ and volOk

if bFVG
    bx = box.new(bar_index-2, low, bar_index, high[2], border_color=sBF ? color.new(cBull,40) : na, bgcolor=sBF ? color.new(cBull,82) : na, text=sBF ? "FVG" : "", text_size=size.tiny, text_color=cBull, text_halign=text.align_right)
    array.push(bfT, low)
    array.push(bfB, high[2])
    array.push(bfI, bar_index)
    array.push(bfX, bx)
    if array.size(bfT) > 15
        box.delete(array.shift(bfX))
        array.shift(bfT)
        array.shift(bfB)
        array.shift(bfI)

if sFVG
    bx = box.new(bar_index-2, low[2], bar_index, high, border_color=sSF ? color.new(cBear,40) : na, bgcolor=sSF ? color.new(cBear,82) : na, text=sSF ? "FVG" : "", text_size=size.tiny, text_color=cBear, text_halign=text.align_right)
    array.push(sfT, low[2])
    array.push(sfB, high)
    array.push(sfI, bar_index)
    array.push(sfX, bx)
    if array.size(sfT) > 15
        box.delete(array.shift(sfX))
        array.shift(sfT)
        array.shift(sfB)
        array.shift(sfI)

var bool ifvgB = false
var bool ifvgS = false
ifvgB := false
ifvgS := false

// Bullish FVG wordt BEARISH IFVG als de close er DOORHEEN valt (close < onderkant)
if array.size(bfT) > 0
    for i = array.size(bfT) - 1 to 0
        b  = array.get(bfB, i)
        ix = array.get(bfI, i)
        bx = array.get(bfX, i)
        if bar_index - ix > fvgAge
            box.delete(bx)
            array.remove(bfT, i)
            array.remove(bfB, i)
            array.remove(bfI, i)
            array.remove(bfX, i)
        else if close < b
            ifvgS := true
            box.set_bgcolor(bx,      color.new(cBear, 80))
            box.set_border_color(bx, color.new(cBear, 30))
            box.set_text(bx, "IFVG")
            box.set_right(bx, bar_index)
            if showV and ssOn
                label.new(bar_index, high, "IFVG", style=label.style_label_down, color=color.new(cBear,5), textcolor=color.white, size=size.small)
            array.remove(bfT, i)
            array.remove(bfB, i)
            array.remove(bfI, i)
            array.remove(bfX, i)
        else
            box.set_right(bx, bar_index)

// Bearish FVG wordt BULLISH IFVG als de close er DOORHEEN gaat (close > bovenkant)
if array.size(sfT) > 0
    for i = array.size(sfT) - 1 to 0
        t  = array.get(sfT, i)
        ix = array.get(sfI, i)
        bx = array.get(sfX, i)
        if bar_index - ix > fvgAge
            box.delete(bx)
            array.remove(sfT, i)
            array.remove(sfB, i)
            array.remove(sfI, i)
            array.remove(sfX, i)
        else if close > t
            ifvgB := true
            box.set_bgcolor(bx,      color.new(cBull, 80))
            box.set_border_color(bx, color.new(cBull, 30))
            box.set_text(bx, "IFVG")
            box.set_right(bx, bar_index)
            if showV and bsOn
                label.new(bar_index, low, "IFVG", style=label.style_label_up, color=color.new(cBull,5), textcolor=color.white, size=size.small)
            array.remove(sfT, i)
            array.remove(sfB, i)
            array.remove(sfI, i)
            array.remove(sfX, i)
        else
            box.set_right(bx, bar_index)

// ══ SPIKES ═══════════════════════════════════════════════
cRng    = high - low
isSpike = cRng >= atr * spkMul and volOk
spkBull = isSpike and close > open and (close - open) >= cRng * 0.55
spkBear = isSpike and close < open and (open - close) >= cRng * 0.55
spkWkDn = isSpike and (math.min(open,close) - low)  >= cRng * 0.5
spkWkUp = isSpike and (high - math.max(open,close)) >= cRng * 0.5

if isSpike and showV
    spkDir = close > open or spkWkDn
    label.new(bar_index, spkDir ? low : high, "SPIKE " + str.tostring(cRng, format.mintick), style=spkDir ? label.style_label_up : label.style_label_down, color=color.orange, textcolor=color.black, size=size.large)

barcolor(isSpike ? color.orange : na)

// ══ 4H VISUEEL ═══════════════════════════════════════════
var box h4Bx = na
if (h4Up or h4Dn) and showV and not na(h4OBt)
    if not na(h4Bx)
        box.delete(h4Bx)
    bc  = h4OBd == 1 ? color.new(cBull,75) : color.new(cBear,75)
    brd = h4OBd == 1 ? color.new(cBull,20) : color.new(cBear,20)
    tc  = h4OBd == 1 ? cBull : cBear
    h4Bx := box.new(bar_index, h4OBt, bar_index+200, h4OBb, border_color=brd, bgcolor=bc, text="4H OB", text_size=size.small, text_color=tc, text_halign=text.align_left)
if showV and not na(h4Bx)
    box.set_right(h4Bx, bar_index+50)

if showV and h4Up
    line.new(bar_index-swLen, h4SH, bar_index, h4SH, color=cBull, style=line.style_dashed)
    label.new(bar_index, h4SH, "4H BOS", style=label.style_none, textcolor=cBull, size=size.normal)
if showV and h4Dn
    line.new(bar_index-swLen, h4SL, bar_index, h4SL, color=cBear, style=line.style_dashed)
    label.new(bar_index, h4SL, "4H BOS", style=label.style_none, textcolor=cBear, size=size.normal)
if showV and h4SSL
    label.new(bar_index, h4Lo, "4H SSL", style=label.style_label_up,   color=color.new(cBull,5), textcolor=color.white, size=size.normal)
if showV and h4BSL
    label.new(bar_index, h4Hi, "4H BSL", style=label.style_label_down, color=color.new(cBear,5), textcolor=color.white, size=size.normal)
if showV and sslSw
    line.new(slI, sslLvl, bar_index, sslLvl, color=color.new(cBull,20), style=line.style_dotted, width=2)
    label.new(bar_index, low,  "SSL", style=label.style_label_up,   color=color.new(cBull,5), textcolor=color.white, size=size.normal)
if showV and bslSw
    line.new(shI, bslLvl, bar_index, bslLvl, color=color.new(cBear,20), style=line.style_dotted, width=2)
    label.new(bar_index, high, "BSL", style=label.style_label_down, color=color.new(cBear,5), textcolor=color.white, size=size.normal)
if showV and lUp
    label.new(math.round((shI+bar_index)/2), shP, prevTr==-1 ? "CHoCH" : "BOS", style=label.style_none, textcolor=cBull, size=size.small)
if showV and lDn
    label.new(math.round((slI+bar_index)/2), slP, prevTr==1  ? "CHoCH" : "BOS", style=label.style_none, textcolor=cBear, size=size.small)

// ══ HANDELSSTAAT ═════════════════════════════════════════
var int   pendDir = 0
var float pSL     = na
var float pTP     = na
var float pEn     = na
var float pRsk    = na
var int   pBar    = na
var bool  pLim    = false
var bool  beDone  = false
var label sigLbl  = na
var line  lnE     = na
var line  lnS     = na
var line  lnT     = na
var label lbE     = na
var label lbS     = na
var label lbT     = na

closedNow = strategy.closedtrades > strategy.closedtrades[1]
if closedNow
    trDay   += 1
    pnl      = strategy.closedtrades.profit(strategy.closedtrades - 1)
    if pnl < 0
        lossDay += 1
        lastLos := bar_index
    pendDir := 0
    beDone  := false
    if not na(sigLbl)
        label.set_text(sigLbl,  pnl > 0 ? "WIN" : "LOSS")
        label.set_color(sigLbl, pnl > 0 ? color.green : color.red)

if strategy.position_size != 0 and not na(pRsk)
    longOneR  = strategy.position_size > 0 and high >= pEn + pRsk
    shortOneR = strategy.position_size < 0 and low <= pEn - pRsk
    if useBE and not beDone and (longOneR or shortOneR)
        pSL    := pEn
        beDone := true
    if useTrail and (longOneR or shortOneR)
        pSL := strategy.position_size > 0 ? math.max(pSL, high - pRsk * trailR) : math.min(pSL, low + pRsk * trailR)

if pendDir == 1
    strategy.exit("XL", "L", stop=pSL, limit=pTP)
if pendDir == -1
    strategy.exit("XS", "S", stop=pSL, limit=pTP)

if pendDir != 0 and not na(lnS)
    line.set_x2(lnE, bar_index)
    line.set_x2(lnS, bar_index)
    line.set_x2(lnT, bar_index)
    line.set_y1(lnS, pSL)
    line.set_y2(lnS, pSL)
    label.set_x(lbE, bar_index+2)
    label.set_x(lbS, bar_index+2)
    label.set_x(lbT, bar_index+2)
    label.set_y(lbS, pSL)

// Verloop-logica voor ALLE pending orders (limit: fvgExp bars, market: 1 bar).
// Voorheen gold dit alleen voor limit-orders -> een afgewezen market-order liet pendDir voor altijd vergrendeld.
if pendDir != 0 and strategy.position_size == 0 and not na(pBar)
    if bar_index - pBar > (pLim ? fvgExp : 1)
        strategy.cancel_all()
        pendDir := 0
        beDone  := false
        cExp    += 1
        if not na(lnE)
            line.delete(lnE)
        if not na(lnS)
            line.delete(lnS)
        if not na(lnT)
            line.delete(lnT)
        if not na(sigLbl)
            label.delete(sigLbl)
        if not na(lbE)
            label.delete(lbE)
        if not na(lbS)
            label.delete(lbS)
        if not na(lbT)
            label.delete(lbT)
        lnE    := na
        lnS    := na
        lnT    := na
        sigLbl := na
        lbE    := na
        lbS    := na
        lbT    := na

// ══ ENTRY FUNCTIE ════════════════════════════════════════
doEntry(dir, en, sl, tp, mult, isLim, why) =>
    dist   = math.abs(en - sl)
    rr     = math.abs(tp - en) / math.max(dist, 0.000001)
    q      = calcQ(dist, mult)
    winEur = riskE * mult * rr

    // Return state and drawing handles instead of modifying global variables.
    outSL     = pSL
    outTP     = pTP
    outEn     = pEn
    outRsk    = pRsk
    outDir    = pendDir
    outBar    = pBar
    outLim    = pLim
    outBeDone = beDone
    outSigLbl = sigLbl
    outLnE    = lnE
    outLnS    = lnS
    outLnT    = lnT
    outLbE    = lbE
    outLbS    = lbS
    outLbT    = lbT

    if q > 0.0
        msg = '{"strategy":"ICT Sniper Pro","version":"2.0","symbol":"' + syminfo.ticker + '","timeframe":"' + timeframe.period + '","direction":"' + (dir > 0 ? "LONG" : "SHORT") + '","entry":' + str.tostring(en, format.mintick) + ',"stop":' + str.tostring(sl, format.mintick) + ',"target":' + str.tostring(tp, format.mintick) + '}'
        if dir > 0
            if isLim
                strategy.entry("L", strategy.long, qty=q, limit=en, alert_message=msg)
            else
                strategy.entry("L", strategy.long, qty=q, alert_message=msg)
            strategy.exit("XL", "L", stop=sl, limit=tp)
        else
            if isLim
                strategy.entry("S", strategy.short, qty=q, limit=en, alert_message=msg)
            else
                strategy.entry("S", strategy.short, qty=q, alert_message=msg)
            strategy.exit("XS", "S", stop=sl, limit=tp)

        outSL     := sl
        outTP     := tp
        outEn     := en
        outRsk    := dist
        outDir    := dir
        outBar    := bar_index
        outLim    := isLim
        outBeDone := false
        rrS  = str.tostring(rr,           "#.#")
        risS = str.tostring(riskE * mult, "#.##")
        winS = str.tostring(winEur,       "#.##")
        enS  = str.tostring(en,           format.mintick)
        slS  = str.tostring(sl,           format.mintick)
        outSigLbl := label.new(bar_index, dir > 0 ? low : high, (dir > 0 ? "KOOP " : "VERKOOP ") + why, style=dir > 0 ? label.style_label_up : label.style_label_down, color=dir > 0 ? color.new(cBull, 0) : color.new(cBear, 0), textcolor=color.white, size=size.large, tooltip=why + " 1:" + rrS + " Risico EUR " + risS + " Win EUR " + winS)
        outLnE := line.new(bar_index, en, bar_index + 1, en, color=color.blue, width=2, style=line.style_dashed)
        outLnS := line.new(bar_index, sl, bar_index + 1, sl, color=color.red, width=2)
        outLnT := line.new(bar_index, tp, bar_index + 1, tp, color=color.green, width=2)
        outLbE := label.new(bar_index + 2, en, (isLim ? "LIMIT " : "MKT ") + enS, style=label.style_label_left, color=color.new(color.blue, 20), textcolor=color.white, size=size.small)
        outLbS := label.new(bar_index + 2, sl, "SL " + slS + " -EUR " + risS, style=label.style_label_left, color=color.new(color.red, 20), textcolor=color.white, size=size.small)
        outLbT := label.new(bar_index + 2, tp, "TP 1:" + rrS + " +EUR " + winS, style=label.style_label_left, color=color.new(color.green, 20), textcolor=color.white, size=size.small)

    [q, outSL, outTP, outEn, outRsk, outDir, outBar, outLim, outBeDone, outSigLbl, outLnE, outLnS, outLnT, outLbE, outLbS, outLbT]

// ══ CONDITIES ════════════════════════════════════════════
dispB   = close > open and (close - open) >= atr * disp
dispS   = close < open and (open - close) >= atr * disp
// Displacement hoort bij de MIDDELSTE candle van de FVG ([1]); beide varianten zijn toegestaan
dispBm  = close[1] > open[1] and (close[1] - open[1]) >= atr * disp
dispSm  = close[1] < open[1] and (open[1] - close[1]) >= atr * disp
dispOkB = dispB or (dispMid and bFVG and dispBm)
dispOkS = dispS or (dispMid and sFVG and dispSm)
momB    = macdH > macdH[1] and rsi > 45
momS    = macdH < macdH[1] and rsi < 55
abvEma  = close > ema21 and ema21 > ema50
blwEma  = close < ema21 and ema21 < ema50
abvVwap = close > vwap
blwVwap = close < vwap

cooldownOk = na(lastLos) or bar_index - lastLos >= cool
canTrade = symOk and tfOk and dataReady and inSession and strategy.position_size == 0 and pendDir == 0 and trDay < maxDay and lossDay < maxLoss and cooldownOk and volOk

// ══ LONG ═════════════════════════════════════════════════
newL = false
if canTrade and allowLong and h4Bull and bsOn
    cCtx += 1
    sl0  = swLow - atr * buf
    en0  = bFVG ? (low + high[2]) / 2.0 : close
    d0   = en0 - sl0
    rrOk = not na(h4Hi100) and (h4Hi100 - en0) >= d0 * minRR
    sg1  = bFVG or ifvgB
    sg2  = sg1 and dispOkB
    sg3  = sg2 and rrOk
    sg4  = sg3 and en0 < h4EQ
    sg5  = sg4 and d0 >= minStp * atr and d0 <= maxStp * atr
    cSig  += sg1 ? 1 : 0
    cDisp += sg2 ? 1 : 0
    cRR   += sg3 ? 1 : 0
    cDisc += sg4 ? 1 : 0
    cStop += sg5 ? 1 : 0
    if sg5
        sc  = 3
        sc := sc + (momB              ? 1 : 0)
        sc := sc + (abvEma            ? 1 : 0)
        sc := sc + (abvVwap           ? 1 : 0)
        sc := sc + (inGP              ? 1 : 0)
        sc := sc + (h4OBbl            ? 1 : 0)
        sc := sc + (swLPD             ? 1 : 0)
        sc := sc + (lTr == 1          ? 1 : 0)
        sc := sc + (vmcUp and vmcLong ? 1 : 0)
        sc := sc + (gamPos and gamStr ? 1 : 0)
        if sc >= minSc
            cScore += 1
            mm  = sc >= perfSc ? multP : 1.0
            rru = math.min(maxRR, math.max(minRR, (h4Hi100 - en0) / math.max(d0, 0.000001)))
            tp  = en0 + d0 * rru
            [q_L1, sl_L1, tp_L1, en_L1, rsk_L1, dir_L1, bar_L1, lim_L1, be_L1, sig_L1, lne_L1, lns_L1, lnt_L1, lbe_L1, lbs_L1, lbt_L1] = doEntry(1, en0, sl0, tp, mm, bFVG, (bFVG ? "FVG" : "IFVG") + " " + str.tostring(sc) + "/12")
            if q_L1 > 0.0
                cOrd    += 1
                pSL     := sl_L1
                pTP     := tp_L1
                pEn     := en_L1
                pRsk    := rsk_L1
                pendDir := dir_L1
                pBar    := bar_L1
                pLim    := lim_L1
                beDone  := be_L1
                sigLbl  := sig_L1
                lnE     := lne_L1
                lnS     := lns_L1
                lnT     := lnt_L1
                lbE     := lbe_L1
                lbS     := lbs_L1
                lbT     := lbt_L1
            else
                cQ0 += 1
            newL := true

if canTrade and allowLong and not newL and (spkBull[1] or spkWkDn[1]) and h4Bull
    cSpk += 1
    en0 = close
    sl0 = math.max(low[1] - atr * buf, en0 - spkStp * atr)
    d0  = en0 - sl0
    if d0 >= minStp * atr and d0 > 0 and not na(h4Hi100) and (h4Hi100 - en0) >= d0 * minRR
        [q_L2, sl_L2, tp_L2, en_L2, rsk_L2, dir_L2, bar_L2, lim_L2, be_L2, sig_L2, lne_L2, lns_L2, lnt_L2, lbe_L2, lbs_L2, lbt_L2] = doEntry(1, en0, sl0, en0 + d0 * minRR, 1.0, false, "SPIKE LONG")
        if q_L2 > 0.0
            cOrd    += 1
            pSL     := sl_L2
            pTP     := tp_L2
            pEn     := en_L2
            pRsk    := rsk_L2
            pendDir := dir_L2
            pBar    := bar_L2
            pLim    := lim_L2
            beDone  := be_L2
            sigLbl  := sig_L2
            lnE     := lne_L2
            lnS     := lns_L2
            lnT     := lnt_L2
            lbE     := lbe_L2
            lbS     := lbs_L2
            lbT     := lbt_L2
        else
            cQ0 += 1
        newL := true

// ══ SHORT ════════════════════════════════════════════════
newS = false
if canTrade and allowShort and h4Bear and ssOn and not newL
    cCtx += 1
    sl0  = swHi + atr * buf
    en0  = sFVG ? (high + low[2]) / 2.0 : close
    d0   = sl0 - en0
    rrOk = not na(h4Lo100) and (en0 - h4Lo100) >= d0 * minRR
    sg1  = sFVG or ifvgS
    sg2  = sg1 and dispOkS
    sg3  = sg2 and rrOk
    sg4  = sg3 and en0 > h4EQ
    sg5  = sg4 and d0 >= minStp * atr and d0 <= maxStp * atr
    cSig  += sg1 ? 1 : 0
    cDisp += sg2 ? 1 : 0
    cRR   += sg3 ? 1 : 0
    cDisc += sg4 ? 1 : 0
    cStop += sg5 ? 1 : 0
    if sg5
        sc  = 3
        sc := sc + (momS               ? 1 : 0)
        sc := sc + (blwEma             ? 1 : 0)
        sc := sc + (blwVwap            ? 1 : 0)
        sc := sc + (inGP               ? 1 : 0)
        sc := sc + (h4OBbr             ? 1 : 0)
        sc := sc + (swHPD              ? 1 : 0)
        sc := sc + (lTr == -1          ? 1 : 0)
        sc := sc + (vmcDn and vmcShort ? 1 : 0)
        sc := sc + (gamNeg and gamStr  ? 1 : 0)
        if sc >= minSc
            cScore += 1
            mm  = sc >= perfSc ? multP : 1.0
            rru = math.min(maxRR, math.max(minRR, (en0 - h4Lo100) / math.max(d0, 0.000001)))
            tp  = en0 - d0 * rru
            [q_S1, sl_S1, tp_S1, en_S1, rsk_S1, dir_S1, bar_S1, lim_S1, be_S1, sig_S1, lne_S1, lns_S1, lnt_S1, lbe_S1, lbs_S1, lbt_S1] = doEntry(-1, en0, sl0, tp, mm, sFVG, (sFVG ? "FVG" : "IFVG") + " " + str.tostring(sc) + "/12")
            if q_S1 > 0.0
                cOrd    += 1
                pSL     := sl_S1
                pTP     := tp_S1
                pEn     := en_S1
                pRsk    := rsk_S1
                pendDir := dir_S1
                pBar    := bar_S1
                pLim    := lim_S1
                beDone  := be_S1
                sigLbl  := sig_S1
                lnE     := lne_S1
                lnS     := lns_S1
                lnT     := lnt_S1
                lbE     := lbe_S1
                lbS     := lbs_S1
                lbT     := lbt_S1
            else
                cQ0 += 1
            newS := true

if canTrade and allowShort and not newL and not newS and (spkBear[1] or spkWkUp[1]) and h4Bear
    cSpk += 1
    en0 = close
    sl0 = math.min(high[1] + atr * buf, en0 + spkStp * atr)
    d0  = sl0 - en0
    if d0 >= minStp * atr and d0 > 0 and not na(h4Lo100) and (en0 - h4Lo100) >= d0 * minRR
        [q_S2, sl_S2, tp_S2, en_S2, rsk_S2, dir_S2, bar_S2, lim_S2, be_S2, sig_S2, lne_S2, lns_S2, lnt_S2, lbe_S2, lbs_S2, lbt_S2] = doEntry(-1, en0, sl0, en0 - d0 * minRR, 1.0, false, "SPIKE SHORT")
        if q_S2 > 0.0
            cOrd    += 1
            pSL     := sl_S2
            pTP     := tp_S2
            pEn     := en_S2
            pRsk    := rsk_S2
            pendDir := dir_S2
            pBar    := bar_S2
            pLim    := lim_S2
            beDone  := be_S2
            sigLbl  := sig_S2
            lnE     := lne_S2
            lnS     := lns_S2
            lnT     := lnt_S2
            lbE     := lbe_S2
            lbS     := lbs_S2
            lbT     := lbt_S2
        else
            cQ0 += 1

// ══ DAG HIGH/LOW VOORSPELLINGSZONES ══════════════════════
// Groene zone = verwachte dag-high gebied | Rode zone = verwachte dag-low gebied
// (dAtr = ATR(5) van de vorige afgesloten dag, zie HTF-blok bovenaan)
dhlHiTop = h4Bull ? h4PDH + dhlBias * dAtr + dhlBuf * dAtr
         : h4Bear ? h4PDH + dhlBuf * dAtr
         : h4PDH + dhlBuf * dAtr * 0.5
dhlHiBot = h4Bull ? h4PDH - dhlBuf * dAtr * 0.3
         : h4Bear ? h4PDH - dhlBuf * dAtr
         : h4PDH - dhlBuf * dAtr * 0.5

dhlLoTop = h4Bear ? h4PDL + dhlBuf * dAtr
         : h4Bull ? h4PDL + dhlBuf * dAtr * 0.3
         : h4PDL + dhlBuf * dAtr * 0.5
dhlLoBot = h4Bear ? h4PDL - dhlBias * dAtr - dhlBuf * dAtr
         : h4Bull ? h4PDL - dhlBuf * dAtr
         : h4PDL - dhlBuf * dAtr * 0.5

pDhlHiTop = plot(showDHL ? dhlHiTop : na, "Dag High top", color=na, display=display.none)
pDhlHiBot = plot(showDHL ? dhlHiBot : na, "Dag High bot", color=na, display=display.none)
fill(pDhlHiTop, pDhlHiBot, color=color.new(color.green, 72), title="Verwachte Dag High Zone")

pDhlLoTop = plot(showDHL ? dhlLoTop : na, "Dag Low top", color=na, display=display.none)
pDhlLoBot = plot(showDHL ? dhlLoBot : na, "Dag Low bot", color=na, display=display.none)
fill(pDhlLoTop, pDhlLoBot, color=color.new(color.red, 72), title="Verwachte Dag Low Zone")

plot(showDHL ? h4PDH : na, "PDH niveau",  color=color.new(color.green, 20), linewidth=2, style=plot.style_linebr)
plot(showDHL ? h4PDL : na, "PDL niveau",  color=color.new(color.red,   20), linewidth=2, style=plot.style_linebr)

// Labels: oude verwijderen zodat ze zich niet opstapelen in realtime
var label lblDhH = na
var label lblDhL = na
if showDHL and barstate.islast and not na(dhlHiTop) and not na(dhlLoBot)
    if not na(lblDhH)
        label.delete(lblDhH)
    if not na(lblDhL)
        label.delete(lblDhL)
    lblDhH := label.new(bar_index+2, dhlHiTop, "DAG HIGH ZONE\n(~85% kans)", style=label.style_label_left, color=color.new(color.green,10), textcolor=color.white, size=size.small)
    lblDhL := label.new(bar_index+2, dhlLoBot, "DAG LOW ZONE\n(~85% kans)",  style=label.style_label_left, color=color.new(color.red,  10), textcolor=color.white, size=size.small)

// ══ PLOTS ════════════════════════════════════════════════
plot(showV ? ema21  : na, "EMA 21",  color=color.new(color.yellow, 0),  linewidth=1)
plot(showV ? ema50  : na, "EMA 50",  color=color.new(color.orange, 0),  linewidth=1)
plot(showV ? ema200 : na, "EMA 200", color=color.new(color.white,  20), linewidth=2)
plot(showV ? vwap   : na, "VWAP",    color=color.new(color.blue,   0),  linewidth=2)
plot(showV ? vwapU1 : na, "VWAP+1",  color=color.new(color.purple, 40), linewidth=1, style=plot.style_linebr)
plot(showV ? vwapL1 : na, "VWAP-1",  color=color.new(color.purple, 40), linewidth=1, style=plot.style_linebr)
plot(showV ? vwapU2 : na, "VWAP+2",  color=color.new(color.purple, 60), linewidth=1, style=plot.style_linebr)
plot(showV ? vwapL2 : na, "VWAP-2",  color=color.new(color.purple, 60), linewidth=1, style=plot.style_linebr)
pgpT = plot(showV ? h4GPt   : na, "GP top", color=na)
pgpB = plot(showV ? h4GPb   : na, "GP bot", color=na)
fill(pgpT, pgpB, color=color.new(color.yellow, 80), title="Golden Pocket")
pHi = plot(showV ? h4Hi100 : na, "4H Hi", color=color.new(color.gray, 75))
pEq = plot(showV ? h4EQ    : na, "4H EQ", color=color.new(color.gray, 15), linewidth=1)
pLo = plot(showV ? h4Lo100 : na, "4H Lo", color=color.new(color.gray, 75))
fill(pHi, pEq, color=color.new(color.red,   93), title="Premium")
fill(pEq, pLo, color=color.new(color.green, 93), title="Discount")
plot(showV ? h4PDH : na, "PDH", color=color.new(color.orange, 35), style=plot.style_linebr)
plot(showV ? h4PDL : na, "PDL", color=color.new(color.orange, 35), style=plot.style_linebr)
bgcolor(volOk and close > open ? color.new(cBull, 96) : volOk and close < open ? color.new(cBear, 96) : na)

// ══ TABELLEN ═════════════════════════════════════════════
tA(b, s) => b ? "▲" : s ? "▼" : "–"
tC(b, s) => b ? color.lime : s ? color.red : color.gray

var table tCtx = table.new(position.top_left, 2, 9, bgcolor=color.new(color.black, 30), border_width=1, frame_color=color.gray)
if showTbl and barstate.islast
    table.cell(tCtx, 0, 0, "CONTEXT",  text_color=color.white,  text_size=size.small)
    table.cell(tCtx, 1, 0, h4Bull ? "4H BULL" : h4Bear ? "4H BEAR" : "4H –", text_color=tC(h4Bull, h4Bear), text_size=size.small)
    table.cell(tCtx, 0, 1, "4H OB",    text_color=color.silver, text_size=size.small)
    table.cell(tCtx, 1, 1, not na(h4OBt) ? str.tostring(h4OBt, format.mintick) : "–", text_color=color.white, text_size=size.small)
    table.cell(tCtx, 0, 2, "4H Sweep", text_color=color.silver, text_size=size.small)
    table.cell(tCtx, 1, 2, h4BsOn ? "SSL" : h4SsOn ? "BSL" : "–", text_color=tC(h4BsOn, h4SsOn), text_size=size.small)
    table.cell(tCtx, 0, 3, "VMC",      text_color=color.silver, text_size=size.small)
    table.cell(tCtx, 1, 3, tA(vmcUp, vmcDn), text_color=tC(vmcUp, vmcDn), text_size=size.normal)
    table.cell(tCtx, 0, 4, "Gamma",    text_color=color.silver, text_size=size.small)
    table.cell(tCtx, 1, 4, gamPos and gamStr ? "▲ sterk" : gamNeg and gamStr ? "▼ sterk" : gamPos ? "▲" : "▼", text_color=tC(gamPos, gamNeg), text_size=size.small)
    table.cell(tCtx, 0, 5, "EMA bias", text_color=color.silver, text_size=size.small)
    table.cell(tCtx, 1, 5, tA(abvEma, blwEma), text_color=tC(abvEma, blwEma), text_size=size.normal)
    table.cell(tCtx, 0, 6, "VWAP",     text_color=color.silver, text_size=size.small)
    table.cell(tCtx, 1, 6, tA(abvVwap, blwVwap), text_color=tC(abvVwap, blwVwap), text_size=size.normal)
    table.cell(tCtx, 0, 7, "Volume",   text_color=color.silver, text_size=size.small)
    table.cell(tCtx, 1, 7, volOk ? "OK" : "laag", text_color=volOk ? color.lime : color.red, text_size=size.small)
    table.cell(tCtx, 0, 8, "Trades",   text_color=color.silver, text_size=size.small)
    table.cell(tCtx, 1, 8, str.tostring(trDay) + "/" + str.tostring(maxDay), text_color=color.white, text_size=size.small)

var table tChk = table.new(position.bottom_left, 2, 5, bgcolor=color.new(color.black, 30), border_width=1, frame_color=color.gray)
if showTbl and barstate.islast
    allOk = symOk and (h4Bull or h4Bear) and (bsOn or ssOn) and volOk and trDay < maxDay and lossDay < maxLoss
    table.cell(tChk, 0, 0, "CHECK",    text_color=color.white,  text_size=size.small)
    table.cell(tChk, 1, 0, allOk ? "KLAAR" : "WACHT", text_color=allOk ? color.lime : color.red, text_size=size.small)
    table.cell(tChk, 0, 1, "Symbool",  text_color=color.silver, text_size=size.small)
    table.cell(tChk, 1, 1, symOk ? syminfo.ticker : "VERKEERD", text_color=symOk ? color.lime : color.red, text_size=size.small)
    table.cell(tChk, 0, 2, "4H+Sweep", text_color=color.silver, text_size=size.small)
    table.cell(tChk, 1, 2, (h4Bull or h4Bear) and (bsOn or ssOn) ? "OK" : "wacht", text_color=(h4Bull or h4Bear) and (bsOn or ssOn) ? color.lime : color.red, text_size=size.small)
    table.cell(tChk, 0, 3, "Volume",   text_color=color.silver, text_size=size.small)
    table.cell(tChk, 1, 3, volOk ? "OK" : "te laag", text_color=volOk ? color.lime : color.red, text_size=size.small)
    table.cell(tChk, 0, 4, "Min RR",   text_color=color.silver, text_size=size.small)
    table.cell(tChk, 1, 4, "1:" + str.tostring(minRR, "#") + " tot 1:" + str.tostring(maxRR, "#"), text_color=color.white, text_size=size.small)

var table tWrn = table.new(position.middle_center, 1, 1, bgcolor=color.new(color.red, 20))
if barstate.islast and (not symOk or not tfOk)
    table.cell(tWrn, 0, 0, not symOk ? "Gebruik alleen XAUUSD of BTCUSD" : "Gebruik een chart van 4H of lager", text_color=color.white, text_size=size.large)

// ══ DEBUG MODE ═══════════════════════════════════════════
dbgRow(tbl, row, name, val, good) =>
    table.cell(tbl, 0, row, name, text_color=color.silver, text_size=size.small)
    table.cell(tbl, 1, row, val,  text_color=good ? color.lime : color.red, text_size=size.small)
    true

plotchar(debugMode and canTrade, "canTrade", "●", location.bottom, color.aqua, size=size.tiny)

var table tDbg = table.new(position.top_right, 2, 26, bgcolor=color.new(color.black, 30), border_width=1, frame_color=color.gray)
if debugMode and barstate.islast
    table.cell(tDbg, 0, 0, "DEBUG", text_color=color.white, text_size=size.small)
    table.cell(tDbg, 1, 0, syminfo.ticker + " " + timeframe.period, text_color=color.white, text_size=size.small)
    dbgRow(tDbg, 1,  "canTrade",        str.tostring(canTrade),  canTrade)
    dbgRow(tDbg, 2,  "h4Bull",          str.tostring(h4Bull),    h4Bull)
    dbgRow(tDbg, 3,  "h4Bear",          str.tostring(h4Bear),    h4Bear)
    dbgRow(tDbg, 4,  "bsOn (sweep low)",  str.tostring(bsOn),    bsOn)
    dbgRow(tDbg, 5,  "ssOn (sweep high)", str.tostring(ssOn),    ssOn)
    dbgRow(tDbg, 6,  "volOk",           str.tostring(volOk),     volOk)
    dbgRow(tDbg, 7,  "pendDir",         str.tostring(pendDir),   pendDir == 0)
    dbgRow(tDbg, 8,  "trades (closed+open)", str.tostring(strategy.closedtrades + strategy.opentrades), strategy.closedtrades + strategy.opentrades > 0)
    dbgRow(tDbg, 9,  "position_size",   str.tostring(strategy.position_size), true)
    dbgRow(tDbg, 10, "symOk",           str.tostring(symOk),     symOk)
    dbgRow(tDbg, 11, "tf <= 4H",        str.tostring(tfOk),      tfOk)
    dbgRow(tDbg, 12, "trDay<maxDay",    str.tostring(trDay < maxDay),     trDay < maxDay)
    dbgRow(tDbg, 13, "lossDay<maxLoss", str.tostring(lossDay < maxLoss),  lossDay < maxLoss)
    dbgRow(tDbg, 14, "cooldownOk",      str.tostring(cooldownOk), cooldownOk)
    table.cell(tDbg, 0, 15, "── FUNNEL (totaal) ──", text_color=color.white, text_size=size.small)
    table.cell(tDbg, 1, 15, "", text_color=color.white, text_size=size.small)
    dbgRow(tDbg, 16, "1 ctx (trend+sweep)", str.tostring(cCtx),   cCtx > 0)
    dbgRow(tDbg, 17, "2 FVG/IFVG",          str.tostring(cSig),   cSig > 0)
    dbgRow(tDbg, 18, "3 displacement",      str.tostring(cDisp),  cDisp > 0)
    dbgRow(tDbg, 19, "4 RR ok",             str.tostring(cRR),    cRR > 0)
    dbgRow(tDbg, 20, "5 discount/premium",  str.tostring(cDisc),  cDisc > 0)
    dbgRow(tDbg, 21, "6 stop in ATR-range", str.tostring(cStop),  cStop > 0)
    dbgRow(tDbg, 22, "7 score >= min",      str.tostring(cScore), cScore > 0)
    dbgRow(tDbg, 23, "8 orders geplaatst",  str.tostring(cOrd),   cOrd > 0)
    dbgRow(tDbg, 24, "qty=0 (geen order)",  str.tostring(cQ0),    cQ0 == 0)
    dbgRow(tDbg, 25, "orders verlopen/spike", str.tostring(cExp) + " / " + str.tostring(cSpk), cExp == 0)

// Alert conditions are setup notifications; broker/webhook authorization remains external.
alertcondition(newL and pendDir == 1, "ICT Sniper Pro LONG", "{\"strategy\":\"ICT Sniper Pro\",\"version\":\"2.0\",\"direction\":\"LONG\",\"symbol\":\"{{ticker}}\",\"timeframe\":\"{{interval}}\",\"time\":\"{{time}}\"}")
alertcondition(newS and pendDir == -1, "ICT Sniper Pro SHORT", "{\"strategy\":\"ICT Sniper Pro\",\"version\":\"2.0\",\"direction\":\"SHORT\",\"symbol\":\"{{ticker}}\",\"timeframe\":\"{{interval}}\",\"time\":\"{{time}}\"}")
